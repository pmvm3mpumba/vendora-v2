rules_version = '2';

// ============================================================================
// VENDORA — Règles de sécurité Firestore (énoncé §17)
//  • Catalogue public en lecture
//  • Seul un vendeur crée des produits, et ne modifie/supprime que les siens
//  • Un client crée ses commandes et ne lit que les siennes
//  • Un vendeur accède aux commandes contenant ses produits
//  • Chacun gère son propre profil (dont ses favoris)
// ============================================================================
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function userData() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data;
    }
    function isSeller() { return signedIn() && userData().role == 'seller'; }

    // ---- Profils utilisateurs (rôle, WhatsApp, favoris) ------------------
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---- Catalogue produits ----------------------------------------------
    match /products/{id} {
      allow read: if true; // visiteurs inclus
      allow create: if isSeller() && request.resource.data.sellerId == request.auth.uid;
      // Le vendeur propriétaire gère tout.
      allow update, delete: if isSeller() && resource.data.sellerId == request.auth.uid;
      // Ajustement ATOMIQUE du stock piloté par les transactions :
      //   • décrément quand un client passe commande,
      //   • ré-incrément quand le client annule une commande en attente.
      // Seul le champ `stock` peut changer (jamais en négatif) ; toute
      // autre modification d'un produit reste interdite aux non-vendeurs.
      allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
          && request.resource.data.stock >= 0;
    }

    // ---- Catégories --------------------------------------------------------
    // Lecture publique ; écriture vendeur autorisée pour le seed de démonstration.
    match /categories/{id} {
      allow read: if true;
      allow write: if isSeller();
    }

    // ---- Commandes ---------------------------------------------------------
    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.clientId == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.clientId == request.auth.uid ||
        request.auth.uid in resource.data.sellerIds
      );
      // Vendeur : mise à jour du statut.
      // Client : UNIQUEMENT l'annulation (orderStatus -> 'cancelled').
      allow update: if signedIn() && (
        request.auth.uid in resource.data.sellerIds ||
        (
          request.auth.uid == resource.data.clientId &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['orderStatus', 'statusHistory']) &&
          request.resource.data.orderStatus == 'cancelled'
        )
      );
      allow delete: if false;
    }

    // ---- Notifications internes (bonus) ------------------------------------
    match /notifications/{id} {
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn();
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
